ServerRoot "{{.ServerRoot}}"
Listen {{.Listen}}
{{if .SSLEnabled}}Listen 443{{end}}

LoadModule authn_core_module modules/mod_authn_core.so
LoadModule authz_core_module modules/mod_authz_core.so
LoadModule authz_host_module modules/mod_authz_host.so
LoadModule dir_module modules/mod_dir.so
LoadModule env_module modules/mod_env.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule mime_module modules/mod_mime.so
LoadModule rewrite_module modules/mod_rewrite.so
LoadModule setenvif_module modules/mod_setenvif.so
LoadModule ssl_module modules/mod_ssl.so
LoadModule alias_module modules/mod_alias.so
LoadModule actions_module modules/mod_actions.so
LoadModule cgi_module modules/mod_cgi.so
# Reverse-proxy modules - needed by Hangar's "Proxy" project type to forward
# Python/Node/Go backends through Apache. Without these, vhosts that use
# ProxyPass / ProxyPassReverse abort with "Invalid command 'ProxyPreserveHost'".
LoadModule proxy_module modules/mod_proxy.so
LoadModule proxy_http_module modules/mod_proxy_http.so
LoadModule proxy_wstunnel_module modules/mod_proxy_wstunnel.so
LoadModule headers_module modules/mod_headers.so

ServerAdmin admin@localhost
ServerName localhost:{{.Listen}}

DocumentRoot "{{.DocumentRoot}}"
<Directory "{{.DocumentRoot}}">
    Options Indexes FollowSymLinks ExecCGI
    AllowOverride All
    Require all granted
</Directory>

<IfModule dir_module>
    DirectoryIndex index.php index.html
</IfModule>

ErrorLog "{{.LogDir}}/apache_error.log"
CustomLog "{{.LogDir}}/apache_access.log" combined

<IfModule mime_module>
    TypesConfig "{{.ServerRoot}}/conf/mime.types"
</IfModule>
{{if .PHPCgiExe}}
# PHP via CGI. Without this block Apache serves index.php as a download:
# AddType alone only labels the Content-Type as application/x-httpd-php,
# which the browser doesn't know how to render so it offers to save the
# file. Routing .php through php-cgi.exe via Action + ScriptAlias makes
# Apache actually execute PHP and return the rendered HTML.
ScriptAlias /__hangar-php-cgi/ "{{.PHPCgiDir}}"
<Directory "{{.PHPCgiDir}}">
    AllowOverride None
    Options None
    Require all granted
</Directory>
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>
Action application/x-httpd-php "/__hangar-php-cgi/php-cgi.exe"
{{end}}

IncludeOptional "{{.ConfDir}}/vhosts/*.conf"
